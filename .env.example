# 默认 DeepSeek 官方；也支持阿里云百炼的 OpenAI 兼容 Chat Completions 接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里平台：取消下方注释并填写控制台的实际值，通用配置优先于旧 DEEPSEEK_* 配置
# LLM_API_KEY=你的阿里API密钥
# LLM_BASE_URL=控制台OpenAI兼容base_url（替换业务空间占位符，不含/chat/completions）
# LLM_MODEL=控制台实际模型ID

# L3 默认沿用 LLM_MODEL（未设置则 deepseek-chat）；仅需独立模型时取消注释
# L1 语义安全分类使用内部流式接收，每次默认允许等待 60 秒（范围 1-300）
L1_LLM_TIMEOUT_SECONDS=60
# L2 语义分析使用内部流式接收；语义分析与 MI 回复默认各允许等待 60 秒（范围 1-300）
L2_LLM_TIMEOUT_SECONDS=60
# 本机 MI 输出诊断（默认关闭）：元数据保存至 artifacts/debug/l2/
# 仅 JSON 解析失败保存原始响应，可能包含患者信息；排查后关闭并删除调试文件。
L2_DEBUG_OUTPUT=false
# CLINICR Step 1 和 Verifier 使用内部流式接收；标准判断只在 Step 1 执行，每次默认等待 60 秒（范围 1-300）
L3_LLM_TIMEOUT_SECONDS=60
L3_INSTRUCTION_TIMEOUT_SECONDS=60
# Qwen3 保持思考开启；medium 比模型默认 xhigh 更快
L3_REASONING_EFFORT=medium
# L3_REASONER_MODEL=deepseek-chat
# L3_VERIFIER_MODEL=deepseek-chat
# L3_INSTRUCTION_MODEL=deepseek-chat

# L4 生产默认使用 API；mock 只能由自动化测试显式启用
L4_LLM_PROVIDER=openai_compat
# L4 默认沿用共享地址和模型；仅需独立服务时取消注释
# L4_LLM_BASE_URL=https://api.deepseek.com
L4_LLM_API_KEY=
# L4_LLM_MODEL=deepseek-chat
L4_LLM_TEMPERATURE=0.7
# L5 默认使用本地适配器调用真实审核 API
L4_REVIEW_MODE=l5_local
# L5 审核 API 默认允许等待 60 秒（范围 1-300）
L5_LLM_TIMEOUT_SECONDS=60
L4_MAX_REWRITE_ATTEMPTS=3
