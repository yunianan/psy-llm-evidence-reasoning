# Patient Agent 环境变量示例。复制为 .env 后按需填写；.env 不要提交到版本库。
# 全部留空也能跑：默认是「离线确定性 + 内置 Mock 五层桩」，不需要任何密钥、不出网。

# ---------------------------------------------------------------- 患者生成器
# offline = 规则/模板渲染（默认。确定性，pytest 与演示都走这条）
# auto    = 有 OPENAI_API_KEY 就用真模型，没有就自动退回 offline（本地开发友好）
# api     = 强制真模型，缺 key 直接报错（防止「以为在测真模型、其实在测规则」）
PATIENT_AGENT_LLM_MODE=offline

# 仅 llm_mode=auto/api 且想走真模型时才需要。base_url 可指向任意 OpenAI 兼容服务：
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   vLLM/本地   http://127.0.0.1:8000/v1
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
OPENAI_TIMEOUT=60
OPENAI_TEMPERATURE=0.7

# 生成器单轮最多重试几次（守卫判定患者说了病例外内容时重说）。
PATIENT_AGENT_MAX_RETRIES=2

# ------------------------------------------------------- 完整系统 API（编排器）
# mock = 内置五层桩（默认，client/mock_system.py）
# http = 连真实编排器，需要下面的 BASE_URL
SYSTEM_API_MODE=mock
SYSTEM_API_BASE_URL=
SYSTEM_API_TIMEOUT=30
# 可选：服务端鉴权头，按需填写
SYSTEM_API_TOKEN=

# ------------------------------------------------------------------- 路径
# 病例库根目录（默认 patient agent/scenarios）
PATIENT_AGENT_SCENARIO_DIR=
# 报告与逐轮记录写到哪里（默认 patient agent/runs）
PATIENT_AGENT_OUT_DIR=
